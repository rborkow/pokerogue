+  /** EXPERIMENT E6: per-type cache of filtered attributes; invalidated if the attribute list grows. */
+  private readonly attrCache = new Map<AbAttrString, readonly AbAttr[]>();
+  private attrCacheSize = -1;
+
   /**
    * Get all ability attributes that match `attrType`
    * @param attrType - any attribute that extends {@linkcode AbAttr}
    * @returns Array of attributes that match `attrType`, Empty Array if none match.
    */
   getAttrs<T extends AbAttrString>(attrType: T): AbAttrMap[T][] {
-    const targetAttr = AbilityAttrs[attrType];
-    if (!targetAttr) {
