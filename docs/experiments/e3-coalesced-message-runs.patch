diff --git a/src/phase-tree.ts b/src/phase-tree.ts
index 4f9aa06..2ca906e 100644
--- a/src/phase-tree.ts
+++ b/src/phase-tree.ts
@@ -103,6 +103,16 @@ export class PhaseTree {
    * Remove and return the first {@linkcode Phase} from the topmost level of the tree.
    * @returns The next {@linkcode Phase}, or `undefined` if the Tree is empty
    */
+  /** EXPERIMENT E3: the phase that would run next, without removing it. */
+  public peekNextPhase(): Phase | undefined {
+    for (let level = this.levels.length - 1; level >= 0; level--) {
+      if (this.levels[level].length > 0) {
+        return this.levels[level][0];
+      }
+    }
+    return;
+  }
+
   public getNextPhase(): Phase | undefined {
     // Clear out all empty levels from the tree
     this.currentLevel = this.levels.length - 1;
